            {
              "size": 6,
              "blocks": [
                {
                  "type": "Headline",
                  "text": "How to use it",
                  "level": "h2"
                },
                {
                  "type": "BulletList",
                  "items": [
                    "Print it, or fill it in on your phone",
                    "Start a few days before the appointment, not the morning of",
                    "Take it in and keep it open in front of you",
                    "Write down what was said before you get back to the car"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tone": "faq",
