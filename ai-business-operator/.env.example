# ---------------------------------------------------------------------------
# AI Business Operator — environment template
# Copy to .env and fill in. NEVER commit .env. NEVER expose these to the frontend.
# ---------------------------------------------------------------------------

# --- Core services ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aibo:aibo@localhost:5432/aibo
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Web auth --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-first-run
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM providers ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- systeme.io ------------------------------------------------------------
# Settings -> MCP & API Keys. MCP keys expire after 90 days at most; rotate early.
# Server-side only. These must never reach the browser bundle.
SYSTEMEIO_MCP_KEY=
SYSTEMEIO_API_KEY=
SYSTEMEIO_API_BASE=https://api.systeme.io/api
SYSTEMEIO_MCP_BASE=https://mcp.systeme.io
SYSTEMEIO_LOGIN_EMAIL=
SYSTEMEIO_LOGIN_PASSWORD=

# --- Safety rails ----------------------------------------------------------
# DRY_RUN logs outbound systeme.io writes instead of performing them.
DRY_RUN=true
# Park publish/payment tasks in `awaiting_approval` until a human releases them.
REQUIRE_HUMAN_APPROVAL=true
# Cap on concurrent headless browsers, to stay under systeme.io rate limits.
MAX_BROWSER_SESSIONS=2

# --- Browser agent ---------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_ARTIFACT_DIR=./artifacts

# --- Frontend (safe to expose; NEXT_PUBLIC_ values ship to the browser) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
