# You normally never touch this file: `npm run setup` asks a few
# questions and writes the real .env for you. This copy just documents
# every setting for anyone doing it by hand.
#
# Copy this file to .env for local testing (never commit the real .env).
# For GitHub Actions, add these same names as repo Secrets instead
# (Settings -> Secrets and variables -> Actions). For the lead webhook,
# add them as Environment Variables in your Vercel project settings.

# --- Required: Notion ---
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source IDs - yours will be different after duplicating the
# template. Run: node scripts/find-data-source-ids.js <your Home page link>
# instead of hunting these down by hand.
CLIENTS_DATA_SOURCE_ID=
LEADS_DATA_SOURCE_ID=
SOA_RECORDS_DATA_SOURCE_ID=
APPOINTMENTS_DATA_SOURCE_ID=
POLICIES_DATA_SOURCE_ID=
CARRIER_REFERENCE_DATA_SOURCE_ID=
TASKS_DATA_SOURCE_ID=

# --- Optional: email alerts (SendGrid) ---
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Optional: SMS alerts (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# --- Lead webhook only (set in Vercel, not GitHub Actions) ---
WEBHOOK_SECRET=choose-a-random-string
